NODE_ENV=development
PORT=5000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
JWT_ISSUER=learnmatch-api
JWT_USER_AUDIENCE=learnmatch-web
JWT_ADMIN_AUDIENCE=learnmatch-admin
JWT_RESET_AUDIENCE=learnmatch-password-reset
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=gpt-5.6-luna
OPENROUTESERVICE_API_KEY=

# PDF source download/parser bytes: default 6 MiB; positive integer, hard maximum 16 MiB.
# HTML remains capped at 2 MiB. Compressed HTTP responses remain unsupported.
SOURCE_PDF_MAX_BYTES=6291456

# Exact approved publisher hosts only; empty blocks new source URLs/checks/confirmations.
# Subdomains must be listed separately. No wildcards or automatic .edu/.gov trust.
SOURCE_APPROVED_PUBLISHER_HOSTS=

# Add Draft source analysis only. Enable deliberately after local browser verification.
# Backend OPENAI_API_KEY above is reused; no client-side key. No automatic model fallback.
SOURCE_AI_ENABLED=false
SOURCE_AI_MODEL=gpt-6-luna
SOURCE_AI_REASONING_EFFORT=low
SOURCE_AI_PROMPT_VERSION=source-review-v4
SOURCE_AI_TIMEOUT_MS=12000
# Scanned PDFs use gpt-6-luna / low / high PDF detail, without retries/model switching.
SOURCE_AI_PDF_TIMEOUT_MS=60000
SOURCE_AI_PDF_MAX_OUTPUT_TOKENS=1800
# Separate per-source input budgets include instructions, schema and comparison context.
# Text uses a conservative upper bound. Scanned PDFs require an API token-count
# preflight and are refused before generation when over their separate budget.
SOURCE_AI_MAX_INPUT_TOKENS=12000
SOURCE_AI_PDF_MAX_INPUT_TOKENS=65000
# Includes reasoning tokens, not just visible JSON.
SOURCE_AI_MAX_OUTPUT_TOKENS=1800
SOURCE_AI_CONCURRENCY=1
SOURCE_AI_REQUESTS_PER_MINUTE=6
SOURCE_AI_CACHE_SECONDS=600
# Optional explicit prices only. Blank means no cost estimate; no built-in pricing assumptions.
SOURCE_AI_INPUT_USD_PER_MILLION=
SOURCE_AI_CACHED_INPUT_USD_PER_MILLION=
SOURCE_AI_CACHE_WRITE_USD_PER_MILLION=
SOURCE_AI_OUTPUT_USD_PER_MILLION=
